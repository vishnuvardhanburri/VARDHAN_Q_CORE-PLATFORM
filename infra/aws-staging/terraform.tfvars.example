# Copy to terraform.tfvars locally; do not commit real values.
aws_region = "ap-south-1"
vpc_cidr = "10.84.0.0/16"

# Restrict to office/VPN egress CIDRs for private customer testing.
allowed_client_cidrs = ["203.0.113.10/32"]

# Must be an ISSUED ACM certificate ARN in ap-south-1.
acm_certificate_arn = "arn:aws:acm:ap-south-1:111122223333:certificate/REPLACE-ME"

# Use ECR image URIs pinned to immutable digests, not tags.
api_image = "111122223333.dkr.ecr.ap-south-1.amazonaws.com/qcore-api@sha256:REPLACE_WITH_64_HEX_DIGEST"
web_image = "111122223333.dkr.ecr.ap-south-1.amazonaws.com/qcore-web@sha256:REPLACE_WITH_64_HEX_DIGEST"

# Secret ARNs only; never put secret values in this file.
database_url_secret_arn = "arn:aws:secretsmanager:ap-south-1:111122223333:secret:qcore/staging/database-url-REPLACE"
admin_password_secret_arn = "arn:aws:secretsmanager:ap-south-1:111122223333:secret:qcore/staging/admin-password-REPLACE"

postgres_db_name = "vardhan_control_plane"
postgres_master_username = "qcore_admin"
postgres_engine_version = "16.4"
postgres_instance_class = "db.t4g.medium"
postgres_multi_az = false
