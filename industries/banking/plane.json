  "policies": ["payment_integrity", "privileged_access", "third_party_risk", "customer_data_protection", "cryptographic_key_lifecycle"],
  "workflows": ["payment_exposure_scan", "third_party_risk_review", "endpoint_integrity_check", "compliance_validation", "high_risk_transaction_review"],
  "controls": ["transaction_monitoring", "fraud_detection", "network_segmentation", "pam", "hsm_key_protection", "dual_authorization"],
  "integrations": ["siem", "iam", "fraud_engine", "payment_gateway", "hsm_kms", "itsm"],
  "deployment": {"modes": ["managed", "private_cloud", "regulated_on_prem"], "requires_hsm_for_private_keys": true, "telemetry": "tenant_bound_qcore"},
