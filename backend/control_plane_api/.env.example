# Vardhan Enterprise Control Plane
# Production: store secrets in the approved secret manager/HSM boundary; never commit real values.

VARDHAN_CONTROL_PLANE_ADDR=127.0.0.1:8080
VARDHAN_CONTROL_PLANE_DATA_DIR=/var/lib/vardhan/control-plane
VARDHAN_NODE_ID=control-plane-01

# Explicit browser origin allowlist. Multiple origins are comma-separated.
# Leave unset for same-origin deployments; cross-origin access is denied by default.
VARDHAN_ALLOWED_ORIGINS=https://console.example.com

# Authentication bootstrap must be provisioned through the existing credential-store
# administration path. Do not add credentials to this file.

# Enterprise identity boundary (required before production if SSO is in scope):
# VARDHAN_OIDC_ISSUER=
# VARDHAN_OIDC_CLIENT_ID=
# VARDHAN_OIDC_CLIENT_SECRET=
# VARDHAN_OIDC_REDIRECT_URI=
# VARDHAN_MFA_REQUIRED=true

# AER-KEP-Q runtime. The vault password must come from the deployment secret boundary.
# Runtime state is encrypted and restart-safe; the process advances to a fresh epoch on restart.
# VARDHAN_AER_KEP_Q_VAULT_PASS=
VARDHAN_AER_KEP_Q_DOMAIN_ID=control-plane

# Billing provider integration. Paid entitlement activation requires a verified,
# signed provider event; selecting a plan never grants paid capabilities.
# VARDHAN_BILLING_PROVIDER=hmac
# VARDHAN_BILLING_WEBHOOK_SECRET=
