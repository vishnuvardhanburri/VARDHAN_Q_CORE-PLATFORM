{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "bench": {
      "dependsOn": ["^build"]
    },
    "fresh-install": {
      "dependsOn": ["^build", "build"]
    },
    "e2e": {
      "dependsOn": ["^build", "build"]
    }
  }
}
