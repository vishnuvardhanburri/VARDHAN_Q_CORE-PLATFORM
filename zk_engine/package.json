{
  "name": "zk-proof-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge proof engine: circuits, registry, API, CLI, CI gatekeeper, dashboard",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
