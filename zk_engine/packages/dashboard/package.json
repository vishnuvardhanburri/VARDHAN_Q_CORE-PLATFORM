{
  "name": "@zkpe/dashboard",
  "version": "0.1.0",
  "description": "Milestone 9: React dashboard — read-only observability over the M5 API, circuit-lib manifests, and M7-M8 gatekeeper reports (docs/20)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server/server/dashboard.js",
  "types": "./dist/server/server/dashboard.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "start": "node dist/server/server/main.js",
    "smoke": "node ../../scripts/smoke-dashboard.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@zkpe/api": "0.2.0",
    "@zkpe/circuit-lib": "0.2.0",
    "fastify": "^5.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
