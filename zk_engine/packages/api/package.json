{
  "name": "@zkpe/api",
  "version": "0.2.0",
  "description": "Backend REST API (M5): orchestrates @zkpe/engine verification and registry contract reads/writes; HMAC auth, RBAC, OpenAPI 3.1, OTel tracing, audit, metrics per docs/18",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.29.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.56.0",
    "@opentelemetry/resources": "^1.29.0",
    "@opentelemetry/sdk-trace-base": "^1.29.0",
    "@opentelemetry/semantic-conventions": "^1.29.0",
    "@zkpe/circuit-lib": "0.2.0",
    "@zkpe/engine": "0.2.0",
    "@zkpe/proof-format": "0.2.0",
    "ethers": "^6.17.0",
    "fastify": "^5.11.3",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
