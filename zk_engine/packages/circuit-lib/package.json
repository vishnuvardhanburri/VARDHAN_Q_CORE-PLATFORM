{
  "name": "@zkpe/circuit-lib",
  "version": "0.2.0",
  "description": "Versioned circom circuits (Poseidon), compile tooling, and deterministic artifact certification (ADR-0008)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "circuits",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:circuits": "node scripts/build-circuits.mjs",
    "build:ptau": "node scripts/build-ptau.mjs",
    "keygen": "node scripts/keygen.mjs",
    "certify": "node scripts/certify-circuits.mjs"
  },
  "dependencies": {
    "@zkpe/proof-format": "0.2.0",
    "circomlib": "2.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
