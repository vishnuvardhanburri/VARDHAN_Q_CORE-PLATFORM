{
  "name": "@zkpe/proof-format",
  "version": "0.2.0",
  "description": "Versioned proof envelope, canonical serialization, and hashing shared by engine, API, CLI, contracts, and gatekeeper",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
