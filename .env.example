# ===================================================================
# VARDHAN Q-CORE — Canonical Environment Template
# ===================================================================
# Copy to .env and adjust as needed.
# Never commit a populated .env with real secrets.

# ── Environment & Ports ───────────────────────────────────────────
VARDHAN_ENV=development
VARDHAN_CONTROL_PLANE_PORT=8080
VARDHAN_INTELLIGENCE_PORT=3000
VITE_API_URL=http://localhost:8080

# ── Control Plane Server ──────────────────────────────────────────
VARDHAN_CONTROL_PLANE_ADDR=127.0.0.1:8080
VARDHAN_CONTROL_PLANE_DATA_DIR=./.vardhan_data/control-plane
VARDHAN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ── Transport Security (TLS / HTTPS) ───────────────────────────────
# In production, either provide TLS cert/key paths or terminate TLS at ingress proxy
# (set VARDHAN_TLS_TERMINATION=ingress). Control plane fails closed in production if unset.
# VARDHAN_TLS_CERT_PATH=/etc/ssl/certs/vardhan.crt
# VARDHAN_TLS_KEY_PATH=/etc/ssl/certs/vardhan.key
# VARDHAN_TLS_CLIENT_CA_PATH=/etc/ssl/certs/ca.crt
# VARDHAN_TLS_TERMINATION=ingress

# ── Auth Bootstrap ────────────────────────────────────────────────
# In production, inject via VARDHAN_ADMIN_PASSWORD_FILE or vault secret.
# Bare boots in production fail closed if password is unset.
VARDHAN_ADMIN_USERNAME=admin
# VARDHAN_ADMIN_PASSWORD=
# VARDHAN_ADMIN_PASSWORD_FILE=/var/run/secrets/admin_password

# ── Storage & Key Material ────────────────────────────────────────
VARDHAN_KEYSTORE_DIR=./.vardhan_data/keystore
VARDHAN_IDEMPOTENCY_DIR=./.vardhan_data/idempotency
VARDHAN_AUTH_CONFIG_PATH=./.vardhan_data/auth_config/auth_config.json

# ── Service Secrets ───────────────────────────────────────────────
# Required for Q-Core receipt ingestion (min 16 chars).
# Can also be mounted via file: VARDHAN_QCORE_SERVICE_SECRET_FILE
# VARDHAN_QCORE_SERVICE_SECRET=your-high-entropy-receipt-secret-here
# VARDHAN_QCORE_SERVICE_SECRET_FILE=/var/run/secrets/qcore_service_secret

# Required for billing webhook HMAC-SHA256 signature verification (min 16 chars).
# VARDHAN_BILLING_WEBHOOK_SECRET=your-billing-webhook-hmac-secret-min16chars

# ── SCIM 2.0 Directory Sync ───────────────────────────────────────
# Per-organization BLAKE3 token hash for enterprise identity synchronization.
# VARDHAN_SCIM_ORGANIZATION=org-enterprise
# VARDHAN_SCIM_TOKEN_HASH=blake3_hex_digest_of_bearer_token

# ── Enterprise OIDC Single Sign-On ────────────────────────────────
# All OIDC endpoints require HTTPS in production.
# VARDHAN_OIDC_ISSUER=https://idp.example.com
# VARDHAN_OIDC_CLIENT_ID=vardhan-qcore-client
# VARDHAN_OIDC_CLIENT_SECRET=your-oidc-client-secret
# VARDHAN_OIDC_REDIRECT_URI=https://console.example.com/api/v1/auth/oidc/callback
# VARDHAN_OIDC_DEFAULT_ORG=org-enterprise
# VARDHAN_OIDC_AUTO_PROVISION=true

# ── Enterprise SAML 2.0 Single Sign-On ────────────────────────────
# VARDHAN_SAML_ENTITY_ID=https://console.example.com/api/v1/auth/saml/metadata
# VARDHAN_SAML_ACS_URL=https://console.example.com/api/v1/auth/saml/acs
# VARDHAN_SAML_IDP_ENTITY_ID=https://idp.example.com/saml2
# VARDHAN_SAML_IDP_METADATA_XML=
# VARDHAN_SAML_IDP_METADATA_PATH=/etc/vardhan/idp-metadata.xml
# VARDHAN_SAML_IDP_METADATA_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# VARDHAN_SAML_DEFAULT_ORG=org-enterprise
# VARDHAN_SAML_AUTO_PROVISION=true

# ── WebAuthn / Passkeys ───────────────────────────────────────────
# RP_ID must match the production effective domain. Origin must use HTTPS.
# VARDHAN_WEBAUTHN_RP_ID=console.example.com
# VARDHAN_WEBAUTHN_ORIGIN=https://console.example.com
# VARDHAN_WEBAUTHN_ALLOW_INSECURE_DEV=false

# ── Q-Core Issuer Registry (JSON string) ──────────────────────────
# VARDHAN_QCORE_ISSUER_REGISTRY_JSON=

# ── AER-KEP-Q Runtime ─────────────────────────────────────────────
# VARDHAN_AER_KEP_Q_VAULT_PASS=

# ── Database Durability & Clustering ──────────────────────────────
# DATABASE_URL=postgres://vardhan:vardhan_secure_db_pass@postgres:5432/vardhan_control_plane
# POSTGRES_DB=vardhan_control_plane
# POSTGRES_USER=vardhan
# POSTGRES_PASSWORD=vardhan_secure_db_pass
# VARDHAN_CLUSTER_PEERS=node-02=10.0.0.2:8080,node-03=10.0.0.3:8080
# VARDHAN_NODE_ID=control-plane-01

# ── Rate Limiting & Proxy Trust ───────────────────────────────────
# VARDHAN_GLOBAL_RATE_LIMIT_RPS=250
# VARDHAN_TRUST_FORWARDED_HEADERS=true
# VARDHAN_MFA_ENFORCE=true

# ── Telemetry ─────────────────────────────────────────────────────
VARDHAN_TELEMETRY_DISABLED=true
